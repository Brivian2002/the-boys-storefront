# Afrocentric Jewelry by LaGlitz — Environment Variables

# --- Database (required) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# --- Auth (required) ---
ADMIN_SESSION_SECRET=

# --- Blogger (product database) ---
BLOGGER_BLOG_ID=
BLOGGER_API_KEY=
GOOGLE_BLOGGER_CLIENT_ID=
GOOGLE_BLOGGER_CLIENT_SECRET=
GOOGLE_BLOGGER_REFRESH_TOKEN=

# --- Blog (separate blog — optional, can use same blog) ---
BLOG_BLOGGER_BLOG_ID=

# --- Paystack (required in production) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Groq AI assistant (optional; server-side only) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- EmailJS (contact form) ---
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
# Required for paid-order server notifications when EmailJS strict API access is enabled.
EMAILJS_PRIVATE_KEY=
CONTACT_INBOX_EMAIL=laglitz@gmail.com

# --- Image storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- App ---
APP_BASE_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Optional ---
MAPS_API_KEY=
ANALYTICS_ENDPOINT=
ANALYTICS_WEBSITE_ID=
